{
  "hosting": {
    "site": "pocketcoach-280c4",
    "public": "_site",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "headers": [
      {
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "regex": "^/\\.well-known/apple-app-site-association$"
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|ico|woff|woff2|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/pricing",
        "destination": "/pricing.html"
      },
      {
        "source": "/payment-success",
        "destination": "/payment-success.html"
      },
      {
        "source": "/delete-account",
        "destination": "/delete-account.html"
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5535
    },
    "ui": {
      "enabled": false
    }
  }
}
